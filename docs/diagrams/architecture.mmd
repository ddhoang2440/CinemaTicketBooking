flowchart TB
  UI["React 19 SPA (frontend)"] --> CORE["Core Service (:4001) - TV1..TV5"]
  UI --> PAY["Payment Service (:4002) - TV4"]
  CORE -->|create payment intent / refund| PAY
  PAY -->|payment outcome callback| CORE
  CORE -->|send confirmation / QR / cancellation email| NOTIF["Notification Service (:4003) - TV5"]
  PAY -->|optional refund/receipt notification| NOTIF
  CORE --> DBCORE[("PostgreSQL 17 - core schema")]
  PAY --> DBPAY[("PostgreSQL 17 - payment schema")]
  NOTIF --> DBNOTIF[("PostgreSQL 17 - notification schema")]
  CORE --> REDIS[("Redis 7 - shared rate limiter")]
  PAY --> REDIS

