{
  "name": "@cinema/notification-service",
  "version": "0.1.0",
  "private": true,
  "description": "Cinema Ticket Booking — notification-service (TV5 — Email & Notification Delivery)",
  "type": "module",
  "main": "./dist/src/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "db:migrate:latest": "knex --knexfile knexfile.ts migrate:latest",
    "db:migrate:rollback": "knex --knexfile knexfile.ts migrate:rollback",
    "db:seed:run": "knex --knexfile knexfile.ts seed:run"
  },
  "dependencies": {
    "@cinema/api-contracts": "*",
    "@cinema/shared-types": "*",
    "@cinema/shared-utils": "*",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.0.1",
    "helmet": "^8.0.0",
    "knex": "^3.1.0",
    "nodemailer": "^10.6.0",
    "pg": "^8.13.1",
    "redis": "^4.7.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0"
  }
}
