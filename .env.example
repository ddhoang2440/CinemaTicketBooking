# =============================================================================
# Cinema Ticket Booking System — Root Environment Template
# Copy this file to .env for local development. DO NOT commit real secrets.
# =============================================================================

NODE_ENV=development
TZ=Asia/Ho_Chi_Minh

# PostgreSQL 17 (Shared instance with 3 isolated service schemas per D-04 Revised: core, payment, notification)
POSTGRES_USER=cinema_user
POSTGRES_PASSWORD=cinema_dev_password_placeholder
POSTGRES_DB=cinema
POSTGRES_PORT=5432
DATABASE_URL=postgresql://cinema_user:cinema_dev_password_placeholder@localhost:5432/cinema

# Redis 7 (Shared rate limiter backend per D-14)
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Backend Service Ports (D-04 Revised: 3 independent Express 5 processes)
CORE_SERVICE_PORT=4001
PAYMENT_SERVICE_PORT=4002
NOTIFICATION_SERVICE_PORT=4003

# Internal Service-to-Service Base URLs
CORE_SERVICE_URL=http://localhost:4001
PAYMENT_SERVICE_URL=http://localhost:4002
NOTIFICATION_SERVICE_URL=http://localhost:4003

# Frontend Port & Origin
FRONTEND_PORT=8080
WEB_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=http://localhost:4001/api/v1

# Public Auth JWT Placeholders (TV1 — Core Service)
JWT_ISSUER=cinema-api
JWT_AUDIENCE=cinema-web
JWT_SECRET=replace_with_at_least_32_byte_random_secret_placeholder
REFRESH_COOKIE_NAME=cinema_refresh

# Internal Service-to-Service Auth JWT Placeholders (D-13)
SERVICE_JWT_ISSUER=cinema-internal
SERVICE_JWT_AUDIENCE=cinema-services
SERVICE_JWT_SECRET=replace_with_at_least_32_byte_internal_service_secret

# Mock Payment Webhook HMAC Secret Placeholder (D-09 — Payment Service)
PAYMENT_WEBHOOK_SECRET=replace_with_at_least_32_byte_webhook_hmac_secret

# Mailpit & SMTP Configuration (TV5 — Notification Service)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Cinema Booking <no-reply@cinema.local>"
MAILPIT_WEB_PORT=8025
MAILPIT_SMTP_PORT=1025

# Accepted Business Rule Constants (D-05, D-06, D-07, D-10, D-11)
SEAT_HOLD_TTL_SECONDS=300
MAX_BOOKING_SEATS=8
CANCELLATION_CUTOFF_MINUTES=120
CHECKIN_EARLY_MINUTES=30
CHECKIN_LATE_MINUTES=30
SHOWTIME_BUFFER_MINUTES=15
