# Frontend SPA — Environment Template
# Only public variables prefixed with VITE_ are exposed to the browser bundle.
# Never place secrets or private keys in this file.

VITE_APP_NAME="Cinema Ticket Booking System"
VITE_API_BASE_URL=http://localhost:4001/api/v1
VITE_CORE_API_URL=http://localhost:4001/api/v1
VITE_PAYMENT_API_URL=http://localhost:4002/api/v1
VITE_NOTIFICATION_API_URL=http://localhost:4003/api/v1
VITE_DEFAULT_TIMEZONE=Asia/Ho_Chi_Minh
