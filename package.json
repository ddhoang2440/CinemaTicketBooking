{
  "name": "cinema-ticket-booking",
  "version": "0.1.0",
  "private": true,
  "description": "Cinema Ticket Booking System — SOA Monorepo (React 19 Frontend + Core, Payment & Notification Express 5 Services)",
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "packages/eslint-config",
    "packages/shared-types",
    "packages/shared-utils",
    "packages/api-contracts",
    "backend/core-service",
    "backend/payment-service",
    "backend/notification-service",
    "frontend"
  ],
  "scripts": {
    "prepare": "npm run build --workspace=@cinema/shared-types --workspace=@cinema/shared-utils --workspace=@cinema/api-contracts",
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "test:e2e": "playwright test",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,md,yml,yaml}\"",
    "dev:frontend": "npm --workspace @cinema/frontend run dev",
    "dev:core": "npm --workspace @cinema/core-service run dev",
    "dev:payment": "npm --workspace @cinema/payment-service run dev",
    "dev:notification": "npm --workspace @cinema/notification-service run dev"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.4.6",
    "vitest": "^3.2.4"
  }
}
